# 复制此文件为 .env 并填入真实值
# cp .env.example .env

# DeepSeek AI API Key（必填）
AI_API_KEY=sk-your-api-key-here

# JWT 密钥（生产环境请更换为随机字符串）
SECRET_KEY=your-secret-key-change-in-production

# 数据库路径（可选，默认 backend/course_agent.db）
# SQLITE_DB_PATH=backend/course_agent.db

# AI 模型（可选）
# AI_MODEL=deepseek-chat

# 是否使用真实 LLM（true/false，默认 true）
USE_REAL_LLM=true
